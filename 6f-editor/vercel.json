{
  "version": 2,
  "framework": null,
  "functions": {
    "api/editor.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://gusro16.github.io"
        }
      ]
    }
  ]
}
